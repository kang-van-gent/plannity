# 'mock' = in-browser demo backend with seed data (default). 'strapi' = real API via the Nuxt BFF.
NUXT_PUBLIC_DATA_SOURCE=mock
# Server-side only. Where the BFF (server/api/bff) reaches Strapi.
NUXT_STRAPI_URL=http://localhost:1337
# Browser-reachable Strapi URL (social sign-in) and where uploaded images are served from.
NUXT_STRAPI_PUBLIC_URL=http://localhost:1337
NUXT_PUBLIC_MEDIA_BASE_URL=http://localhost:1337
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Must match the backend's pricing configuration (1 credit = 10 THB).
NUXT_PUBLIC_CREDIT_PRICE_SATANG=1000
NUXT_PUBLIC_TRIAL_CREDITS=3
NUXT_PUBLIC_CONTACT_EMAIL=hello@plannity.example
