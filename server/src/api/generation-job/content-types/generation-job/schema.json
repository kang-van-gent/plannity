{
  "kind": "collectionType",
  "collectionName": "generation_jobs",
  "info": {
    "singularName": "generation-job",
    "pluralName": "generation-jobs",
    "displayName": "Generation Job",
    "description": "A request to generate N items (spec §18). Created only by the custom generation controller."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand"
    },
    "brandName": {
      "type": "string"
    },
    "inputSnapshot": {
      "type": "json",
      "required": true
    },
    "brandSnapshot": {
      "type": "json"
    },
    "requestedCount": {
      "type": "integer",
      "min": 1,
      "max": 30,
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "failed",
        "cancelled"
      ],
      "default": "queued",
      "required": true
    },
    "completedCount": {
      "type": "integer",
      "default": 0
    },
    "failedCount": {
      "type": "integer",
      "default": 0
    },
    "cancelledCount": {
      "type": "integer",
      "default": 0
    },
    "idempotencyKey": {
      "type": "string",
      "required": true
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::generation-item.generation-item",
      "mappedBy": "job"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "private": false
    }
  }
}
