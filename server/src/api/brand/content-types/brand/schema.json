{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brand",
    "description": "A brand profile owned by a user (spec \u00a78)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "color": {
      "type": "string",
      "maxLength": 9,
      "default": "#6C4CF5"
    },
    "profile": {
      "type": "json",
      "required": true
    },
    "archivedAt": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "private": false
    },
    "contents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::content.content",
      "mappedBy": "brand"
    },
    "maxSeats": {
      "type": "integer",
      "min": 1,
      "description": "Seat limit (active members + pending invitations). Empty = TEAM_DEFAULT_SEATS. Set by plan/billing, never by members."
    },
    "memberships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand-membership.brand-membership",
      "mappedBy": "brand"
    },
    "invitations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand-invitation.brand-invitation",
      "mappedBy": "brand"
    }
  }
}
