{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brand",
    "description": "A brand profile owned by a user (spec §8)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "logoUrl": { "type": "string", "maxLength": 500, "description": "Absolute URL of the brand logo (null = coloured initials). Set only through /brands/:id/logo." },
    "color": {
      "type": "string",
      "maxLength": 9,
      "default": "#6C4CF5"
    },
    "profile": {
      "type": "json",
      "required": true
    },
    "archivedAt": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "private": false
    },
    "contents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::content.content",
      "mappedBy": "brand"
    },
    "maxSeats": {
      "type": "integer",
      "min": 1,
      "description": "Deprecated (pricing v0.2): seats are now an account-wide pool from the owner's plan. Not read anymore."
    },
    "memberships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand-membership.brand-membership",
      "mappedBy": "brand"
    },
    "invitations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand-invitation.brand-invitation",
      "mappedBy": "brand"
    }
  }
}
