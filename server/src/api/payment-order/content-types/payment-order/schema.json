{
  "kind": "collectionType",
  "collectionName": "payment_orders",
  "info": {
    "singularName": "payment-order",
    "pluralName": "payment-orders",
    "displayName": "Payment Order",
    "description": "PromptPay: pending → verifying (slip being checked by Slip2Go) → paid / rejected / awaiting_review (staff). Money in satang. Set status to paid to approve manually — delivery happens exactly once per order."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "credits": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "description": "Credits bought (kind = credits)."
    },
    "amountSatang": {
      "type": "biginteger",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "THB",
      "maxLength": 3
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "verifying",
        "awaiting_review",
        "paid",
        "rejected",
        "failed",
        "expired",
        "refunded"
      ],
      "default": "pending",
      "required": true
    },
    "provider": {
      "type": "string",
      "required": true
    },
    "providerRef": {
      "type": "string",
      "unique": true
    },
    "paidAt": {
      "type": "datetime"
    },
    "reference": {
      "type": "string",
      "unique": true,
      "maxLength": 20,
      "description": "Short code shown to the payer, e.g. PLN-7KQ3XZ."
    },
    "expiresAt": {
      "type": "datetime"
    },
    "slip": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "private": true
    },
    "slipUploadedAt": {
      "type": "datetime"
    },
    "reviewNote": {
      "type": "text",
      "description": "Shown to the user when a slip is rejected."
    },
    "verifiedBy": {
      "type": "enumeration",
      "enum": [
        "staff",
        "slip2go"
      ]
    },
    "verification": {
      "type": "json",
      "private": true,
      "description": "Raw slip-verification result (Slip2Go) for audit."
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "credits",
        "plan",
        "brand_addon",
        "renewal"
      ],
      "default": "credits",
      "required": true
    },
    "planKey": {
      "type": "enumeration",
      "enum": [
        "team",
        "studio"
      ],
      "description": "kind = plan / renewal: one month of this plan."
    },
    "quantity": {
      "type": "integer",
      "min": 1,
      "description": "kind = brand_addon: brands added for one month."
    },
    "brandIds": {
      "type": "json",
      "description": "kind = renewal: brands (documentIds) renewed for one month each."
    },
    "receiverSnapshot": {
      "type": "json",
      "private": true,
      "description": "Who this order must be paid to, frozen at checkout (PromptPay type/number/name)."
    },
    "resultCode": {
      "type": "string",
      "maxLength": 40,
      "description": "Last slip check result shown to the customer (e.g. amount_mismatch, duplicate, unavailable)."
    },
    "fulfilledAt": {
      "type": "datetime",
      "description": "When the credits / plan / brand slots were delivered. Paid without this = still delivering (recovered automatically)."
    },
    "leaseToken": {
      "type": "string",
      "private": true
    },
    "leaseUntil": {
      "type": "datetime",
      "private": true
    },
    "slipLink": {
      "type": "string",
      "private": true,
      "description": "Signed link to view the latest slip (staff only)."
    },
    "qrPayload": {
      "type": "text",
      "description": "PromptPay QR payload generated by Slip2Go (checked: our receiver, exact amount). Empty → the app builds the QR itself."
    },
    "qrSource": {
      "type": "enumeration",
      "enum": [
        "slip2go",
        "local"
      ],
      "default": "local"
    }
  }
}
