{
  "kind": "collectionType",
  "collectionName": "payment_orders",
  "info": {
    "singularName": "payment-order",
    "pluralName": "payment-orders",
    "displayName": "Payment Order",
    "description": "PromptPay: pending → awaiting_review (slip uploaded) → paid / rejected; pending expires. Money in satang. When paid: credits are added, or a month of the plan / brand add-on starts — exactly once per order."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "credits": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "description": "Credits bought (kind = credits)."
    },
    "amountSatang": {
      "type": "biginteger",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "THB",
      "maxLength": 3
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "awaiting_review",
        "paid",
        "rejected",
        "failed",
        "expired",
        "refunded"
      ],
      "default": "pending",
      "required": true
    },
    "provider": {
      "type": "string",
      "required": true
    },
    "providerRef": {
      "type": "string",
      "unique": true
    },
    "paidAt": {
      "type": "datetime"
    },
    "reference": {
      "type": "string",
      "unique": true,
      "maxLength": 20,
      "description": "Short code shown to the payer, e.g. PLN-7KQ3XZ."
    },
    "expiresAt": {
      "type": "datetime"
    },
    "slip": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "private": true
    },
    "slipUploadedAt": {
      "type": "datetime"
    },
    "reviewNote": {
      "type": "text",
      "description": "Shown to the user when a slip is rejected."
    },
    "verifiedBy": {
      "type": "enumeration",
      "enum": [
        "staff",
        "slip2go"
      ]
    },
    "verification": {
      "type": "json",
      "private": true,
      "description": "Raw slip-verification result (Slip2Go) for audit."
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "credits",
        "plan",
        "brand_addon",
        "renewal"
      ],
      "default": "credits",
      "required": true
    },
    "planKey": {
      "type": "enumeration",
      "enum": [
        "team",
        "studio"
      ],
      "description": "kind = plan / renewal: one month of this plan."
    },
    "quantity": {
      "type": "integer",
      "min": 1,
      "description": "kind = brand_addon: brands added for one month."
    },
    "brandIds": {
      "type": "json",
      "description": "kind = renewal: brands (documentIds) renewed for one month each."
    }
  }
}
