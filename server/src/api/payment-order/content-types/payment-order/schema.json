{
  "kind": "collectionType",
  "collectionName": "payment_orders",
  "info": {
    "singularName": "payment-order",
    "pluralName": "payment-orders",
    "displayName": "Payment Order",
    "description": "PromptPay: pending \u2192 awaiting_review (slip uploaded) \u2192 paid / rejected; pending expires. Money in satang. Credits are granted once when status becomes paid."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "credits": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "amountSatang": {
      "type": "biginteger",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "THB",
      "maxLength": 3
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "awaiting_review",
        "paid",
        "rejected",
        "failed",
        "expired",
        "refunded"
      ],
      "default": "pending",
      "required": true
    },
    "provider": {
      "type": "string",
      "required": true
    },
    "providerRef": {
      "type": "string",
      "unique": true
    },
    "paidAt": {
      "type": "datetime"
    },
    "reference": {
      "type": "string",
      "unique": true,
      "maxLength": 20,
      "description": "Short code shown to the payer, e.g. PLN-7KQ3XZ."
    },
    "expiresAt": {
      "type": "datetime"
    },
    "slip": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "private": true
    },
    "slipUploadedAt": {
      "type": "datetime"
    },
    "reviewNote": {
      "type": "text",
      "description": "Shown to the user when a slip is rejected."
    },
    "verifiedBy": {
      "type": "enumeration",
      "enum": [
        "staff",
        "slip2go"
      ]
    },
    "verification": {
      "type": "json",
      "private": true,
      "description": "Raw slip-verification result (Slip2Go) for audit."
    }
  }
}
