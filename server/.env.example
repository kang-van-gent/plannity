HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (the project ships the `pg` driver; create the DB with: createdb plannity)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plannity
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
# or a single connection string instead of the fields above:
# DATABASE_URL=postgres://user:pass@host:5432/plannity

# Public URLs (social sign-in redirects)
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://localhost:3000
# Production only: parent domain shared by the app and this API, so the app can
# finish social sign-in with Strapi's session cookie. Leave empty on localhost.
# SESSION_COOKIE_DOMAIN=plannity.space

# Social sign-in — each provider stays off until its keys are set.
# Provider console redirect URI: <PUBLIC_URL>/api/connect/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Apple: Services ID, Team ID, Key ID and the .p8 private key (newlines as \n)
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Team Workspace
TEAM_DEFAULT_SEATS=5          # seats per brand (members + pending invites) until plans set brand.maxSeats
INVITE_TTL_DAYS=7
# Mail server (Brevo transactional API). Can instead be set in the Strapi admin: Content Manager → App settings.
# Sends team invitations, sign-up confirmation and password-reset emails (designs: src/services/mail/templates.js).
MAIL_ENABLED=false            # true = really send; false = emails are only logged and inviters get a link to share
BREVO_API_KEY=                # Brevo → SMTP & API → API keys (xkeysib-…)
MAIL_FROM_EMAIL=              # e.g. no-reply@plannity.space — a verified sender / authenticated domain in Brevo
MAIL_FROM_NAME=Plannity
MAIL_REPLY_TO=                # optional, e.g. support@plannity.space

# Post images (keep in sync with NUXT_PUBLIC_IMAGE_MAX_MB / NUXT_PUBLIC_IMAGE_MAX_COUNT)
CONTENT_IMAGE_MAX_MB=10
CONTENT_IMAGE_MAX_COUNT=10

# Payments (PromptPay + slip upload)
PROMPTPAY_ID=0968870831            # payee mobile number or 13-digit ID (the QR is built from it)
PROMPTPAY_NAME="Supachai Van Gent" # shown next to the QR
CREDIT_PRICE_SATANG=1000           # 1 credit = 10 THB (keep in sync with NUXT_PUBLIC_CREDIT_PRICE_SATANG)
PAYMENT_ORDER_TTL_MINUTES=30       # payment window; only transfers inside it are approved automatically
PAYMENT_SLIP_MAX_BYTES=5242880     # 5 MB
SLIP_RETENTION_DAYS=30             # slip images deleted after this (orders still under review keep theirs)
# SLIP_STORAGE_DIR=                # private folder for slips (default server/.private/slips — never public)
# SLIP_LINK_SECRET=                # signs staff slip links (defaults to ADMIN_JWT_SECRET)

# Slip2Go automatic slip verification (https://slip2go.com/guide). Leave empty → every slip goes to staff review.
SLIP2GO_API_URL=                   # API URL from the Slip2Go dashboard (https://…)
SLIP2GO_SECRET_KEY=                # Secret Key from the dashboard — backend only, never in Nuxt config
SLIP2GO_TIMEOUT_MS=15000
SLIP2GO_AUTO_APPROVE=false         # true = approve verified slips automatically; false = verified slips still wait for staff
SLIP2GO_GENERATE_QR=true          # checkout QR from Slip2Go (checked: our receiver + exact amount); false = build it locally
# Mobile hand-off (pay on the phone, the computer updates itself): the QR on the
# computer opens FRONTEND_URL/pay/<token> without sign-in, for this order only.
PAYMENT_HANDOFF_TTL_MINUTES=45
PAYMENT_HANDOFF_SECRET=            # optional; defaults to SLIP_LINK_SECRET / ADMIN_JWT_SECRET
# Who must receive the money (checked by Slip2Go on every slip):
PROMPTPAY_TYPE=phone_number        # phone_number | citizen_id | e_wallet
PAYMENT_RECEIVER_ACCOUNT_TYPE=02001 # 02001 PromptPay phone · 02003 national/tax ID · 02004 e-wallet · 01004 KBank account
PAYMENT_RECEIVER_ACCOUNT_NUMBER=   # digits only; defaults to PROMPTPAY_ID
PAYMENT_RECEIVER_NAME_TH=          # registered Thai account name WITHOUT title (นาย/นาง…), as the bank shows it — leave empty unless sure: a wrong name fails every slip
PAYMENT_RECEIVER_BANK_ACCOUNT=     # bank account behind the PromptPay ID (digits). Many slips show this instead of the phone — also accepted
PAYMENT_RECEIVER_BANK_TYPE=01004   # bank of that account (01004 KBank, 01014 SCB, 01002 BBL, 01006 KTB, 01025 Krungsri…)

# Plans (pricing.md v0.2) — prices in satang; leave empty for the defaults
PLAN_TEAM_PRICE_SATANG=34900       # Team ฿349/month
PLAN_STUDIO_PRICE_SATANG=99900     # Studio ฿999/month
BRAND_ADDON_PRICE_SATANG=9900      # extra brand on Solo/Team ฿99/month
# TEAM_DEFAULT_SEATS is no longer used: seats come from the owner's plan (Solo 1, Team 5, Studio 10)

# Social channels — brands connect their own Facebook Page, Instagram and TikTok (Brand → Social channels).
# Meta/TikTok keys, PromptPay and Slip2Go can instead be managed in the Strapi admin: Content Manager → App settings
# (a filled field there overrides this file; empty = use this file). SOCIAL_TOKEN_KEY must stay here.
# Callback URLs to register with the platforms: <PUBLIC_URL>/api/social/callback/meta and <PUBLIC_URL>/api/social/callback/tiktok
SOCIAL_TOKEN_KEY=                  # required in production: encrypts stored tokens (openssl rand -base64 32). Changing it = everyone reconnects
META_APP_ID=                       # developers.facebook.com → your app → App settings → Basic
META_APP_SECRET=
META_GRAPH_VERSION=v27.0
META_LOGIN_CONFIG_ID=              # optional: Facebook Login for Business configuration ID (replaces the scope list)
TIKTOK_CLIENT_KEY=                 # developers.tiktok.com → your app (Login Kit + Content Posting API)
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false               # true once TikTok approved Direct Post (until then posts can only be private)
SOCIAL_FAKE=false                  # LOCAL TESTING ONLY: stand-in Meta/TikTok so Connect/Test can be tried without real apps (ignored in production)
